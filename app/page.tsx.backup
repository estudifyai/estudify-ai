          <div className="text-xs font-semibold text-[var(--purple-light)] uppercase tracking-[2px] mb-3">💰 Precios</div>
          <h2 className="text-3xl md:text-4xl font-extrabold text-white mb-4">Simple y transparente</h2>
          <p className="text-[var(--text2)]">Empieza gratis. Mejora cuando quieras.</p>
        </div>
        <div className="max-w-[1100px] mx-auto grid md:grid-cols-3 gap-5">
          {/* Free */}
          <div className="fade-up bg-[var(--card)] border border-[var(--card-border)] rounded-2xl p-9 transition-all hover:-translate-y-1 hover:border-[rgba(108,63,160,0.3)]">
            <h3 className="font-bold text-xl text-white mb-2">Free</h3>
            <div className="text-4xl font-black text-white">$0<span className="text-sm font-normal text-[var(--text2)]"> /mes</span></div>
            <p className="text-sm text-[var(--text2)] mt-2 mb-6 min-h-[36px]">Para probar Estudify.</p>
            <ul className="space-y-2.5 mb-7">
              {["3 resúmenes al mes", "20 flashcards", "1 examen de práctica", "Exam Readiness básico"].map((f) => (
