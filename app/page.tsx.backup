              className="flex-1 min-w-[220px] px-6 py-4 rounded-full border border-[var(--card-border)] bg-[rgba(255,255,255,0.04)] text-white text-base outline-none focus:border-[var(--purple-light)] transition-colors placeholder:text-[var(--text2)]"
