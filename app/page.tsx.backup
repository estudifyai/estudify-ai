      {/* ══ FOOTER ══ */}
      <footer className="border-t border-[var(--card-border)] text-[var(--text2)] py-16 px-6" style={{ background: "var(--bg2)" }}>
        <div className="max-w-[1200px] mx-auto">
          <div className="grid md:grid-cols-[2fr_1fr_1fr_1fr] gap-10 mb-10">
            <div>
              <Image src="/logo.png" alt="Estudify" width={38} height={38} className="rounded-[10px] mb-3" />
              <p className="text-sm leading-relaxed max-w-[260px]">Estudify.ai — La IA que te entrena para dominar tu examen. Estudia menos, aprende más.</p>
            </div>
            <div>
              <h4 className="text-white font-semibold text-sm mb-4">Producto</h4>
              <a href="#features" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Funciones</a>
              <a href="#how" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Cómo funciona</a>
              <a href="#pricing" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Precios</a>
              <a href="#faq" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">FAQ</a>
            </div>
            <div>
              <h4 className="text-white font-semibold text-sm mb-4">Legal</h4>
              <a href="#" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Privacidad</a>
              <a href="#" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Términos</a>
            </div>
            <div>
              <h4 className="text-white font-semibold text-sm mb-4">Síguenos</h4>
              <a href="https://www.instagram.com/estudify.ai" target="_blank" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">Instagram</a>
              <a href="https://www.tiktok.com/@estudify.ai" target="_blank" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">TikTok</a>
              <a href="https://x.com/estudifyai" target="_blank" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">X (Twitter)</a>
              <a href="https://youtube.com/@estudifyai" target="_blank" className="block text-sm mb-2.5 hover:text-[var(--purple-light)] transition-colors">YouTube</a>
            </div>
          </div>
          <div className="border-t border-[var(--card-border)] pt-6 flex justify-between items-center flex-wrap gap-4">
            <p className="text-xs">© 2026 Estudify.ai — Todos los derechos reservados.</p>
            <div className="flex gap-3">
              {[
                { label: "IG", href: "https://www.instagram.com/estudify.ai" },
                { label: "TT", href: "https://www.tiktok.com/@estudify.ai" },
                { label: "X", href: "https://x.com/estudifyai" },
                { label: "YT", href: "https://youtube.com/@estudifyai" },
              ].map((s) => (
                <a key={s.label} href={s.href} target="_blank" className="w-8 h-8 rounded-full bg-[rgba(255,255,255,0.06)] border border-[var(--card-border)] flex items-center justify-center text-xs text-[var(--text2)] hover:bg-[var(--purple)] hover:border-[var(--purple)] hover:text-white transition-all">
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </footer>

      {/* ══ MODAL ══ */}
      {showModal && (
        <div className="fixed inset-0 bg-[rgba(0,0,0,0.6)] z-[1000] flex items-center justify-center backdrop-blur-sm" onClick={() => setShowModal(false)}>
          <div className="bg-[var(--bg3)] border border-[var(--card-border)] rounded-3xl p-12 text-center max-w-[440px] w-[90%] shadow-[0_24px_80px_rgba(0,0,0,0.4)] animate-[modalIn_0.4s_ease]" onClick={(e) => e.stopPropagation()}>
            <span className="text-5xl block mb-4">🎉</span>
            <h3 className="text-2xl font-extrabold text-white mb-2">¡Bienvenido al futuro del estudio!</h3>
            <p className="text-[var(--text2)] mb-6">Ya estás en la lista. Te avisaremos cuando sea tu turno. 🚀</p>
            <button onClick={() => setShowModal(false)} className="px-9 py-3.5 rounded-full bg-gradient-to-r from-[var(--purple)] to-[var(--purple-light)] text-white font-bold hover:shadow-[0_8px_24px_rgba(108,63,160,0.4)] transition-all">
              ¡Genial!
            </button>
          </div>
        </div>
      )}

    </>
  );
}